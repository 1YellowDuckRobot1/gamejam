                            <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Air Hockey</title>
  <style>
    * {
      box-sizing: border-box;
      user-select: none;
    }

    body {
      margin: 0;
      background: #0b1220;
      color: white;
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }

    h1 {
      margin: 12px 0 8px;
      letter-spacing: 2px;
    }

    .topbar {
      width: 900px;
      max-width: 95vw;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      gap: 12px;
      flex-wrap: wrap;
    }

    .scoreboard {
      display: flex;
      gap: 20px;
      font-size: 24px;
      font-weight: bold;
    }

    .controls {
      font-size: 14px;
      color: #c7d2fe;
    }

    button {
      padding: 10px 16px;
      border: none;
      border-radius: 8px;
      background: #38bdf8;
      color: #00111a;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #67e8f9;
    }

    canvas {
      background: linear-gradient(to bottom, #e0f2fe, #bae6fd);
      border: 6px solid #1e293b;
      border-radius: 18px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
      max-width: 95vw;
      height: auto;
    }
  </style>
</head>
<body>
  <h1>AIR HOCKEY</h1>

  <div class="topbar">
    <div class="scoreboard">
      <div>Left: <span id="leftScore">0</span></div>
      <div>Right: <span id="rightScore">0</span></div>
    </div>
    <div class="controls">
      Left: WASD &nbsp; | &nbsp; Right: Arrow Keys
    </div>
    <button id="restartBtn">Restart</button>
  </div>

  <canvas id="game" width="900" height="500"></canvas>

  <script>
    const canvas = document.getElementById("game");
    const ctx = canvas.getContext("2d");

    const leftScoreEl = document.getElementById("leftScore");
    const rightScoreEl = document.getElementById("rightScore");
    const restartBtn = document.getElementById("restartBtn");

    const WIDTH = canvas.width;
    const HEIGHT = canvas.height;
    const GOAL_SIZE = 160;
    const GOAL_TOP = (HEIGHT - GOAL_SIZE) / 2;
    const GOAL_BOTTOM = GOAL_TOP + GOAL_SIZE;

    const keys = {};

    const game = {
      leftScore: 0,
      rightScore: 0,
      lastTime: 0,
      goalPause: 0
    };

    const puck = {
      x: WIDTH / 2,
      y: HEIGHT / 2,
      r: 14,
      vx: 0,
      vy: 0,
      maxSpeed: 900
    };

    function createPaddle(x, y, color, side) {
      return {
        x,
        y,
        prevX: x,
        prevY: y,
        vx: 0,
        vy: 0,
        r: 26,
        color,
        accel: 1800,
        maxSpeed: 420,
        drag: 0.86,
        side
      };
    }

    const leftPaddle = createPaddle(WIDTH * 0.2, HEIGHT / 2, "#ef4444", "left");
    const rightPaddle = createPaddle(WIDTH * 0.8, HEIGHT / 2, "#22c55e", "right");

    function resetPuck(direction = 1) {
      puck.x = WIDTH / 2;
      puck.y = HEIGHT / 2;

      const angle = (Math.random() * 0.8 - 0.4);
      const speed = 320;
      puck.vx = Math.cos(angle) * speed * direction;
      puck.vy = Math.sin(angle) * speed;
    }

    function resetPaddles() {
      leftPaddle.x = WIDTH * 0.2;
      leftPaddle.y = HEIGHT / 2;
      leftPaddle.vx = 0;
      leftPaddle.vy = 0;
      leftPaddle.prevX = leftPaddle.x;
      leftPaddle.prevY = leftPaddle.y;

      rightPaddle.x = WIDTH * 0.8;
      rightPaddle.y = HEIGHT / 2;
      rightPaddle.vx = 0;
      rightPaddle.vy = 0;
      rightPaddle.prevX = rightPaddle.x;
      rightPaddle.prevY = rightPaddle.y;
    }

    function restartGame() {
      game.leftScore = 0;
      game.rightScore = 0;
      updateScore();
      resetPaddles();
      resetPuck(Math.random() < 0.5 ? -1 : 1);
      game.goalPause = 0;
    }

    function updateScore() {
      leftScoreEl.textContent = game.leftScore;
      rightScoreEl.textContent = game.rightScore;
    }

    function clamp(value, min, max) {
      return Math.max(min, Math.min(max, value));
    }

    function updatePaddle(p, dt, up, down, left, right) {
      p.prevX = p.x;
      p.prevY = p.y;

      let ax = 0;
      let ay = 0;

      if (keys[up]) ay -= p.accel;
      if (keys[down]) ay += p.accel;
      if (keys[left]) ax -= p.accel;
      if (keys[right]) ax += p.accel;

      p.vx += ax * dt;
      p.vy += ay * dt;

      if (ax === 0) p.vx *= p.drag;
      if (ay === 0) p.vy *= p.drag;

      const speed = Math.hypot(p.vx, p.vy);
      if (speed > p.maxSpeed) {
        const scale = p.maxSpeed / speed;
        p.vx *= scale;
        p.vy *= scale;
      }

      p.x += p.vx * dt;
      p.y += p.vy * dt;

      if (p.side === "left") {
        p.x = clamp(p.x, p.r, WIDTH / 2 - p.r - 8);
      } else {
        p.x = clamp(p.x, WIDTH / 2 + p.r + 8, WIDTH - p.r);
      }
      p.y = clamp(p.y, p.r, HEIGHT - p.r);
    }

    function circleCollision(a, b) {
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.hypot(dx, dy);
      const minDist = a.r + b.r;
      return dist < minDist ? { dx, dy, dist, minDist } : null;
    }

    function resolvePaddleCollision(p) {
      const hit = circleCollision(p, puck);
      if (!hit) return;

      let { dx, dy, dist, minDist } = hit;

      if (dist === 0) {
        dx = 1;
        dy = 0;
        dist = 1;
      }

      const nx = dx / dist;
      const ny = dy / dist;
      const overlap = minDist - dist;

      puck.x += nx * overlap;
      puck.y += ny * overlap;

      const paddleVelX = (p.x - p.prevX) / (1 / 60);
      const paddleVelY = (p.y - p.prevY) / (1 / 60);

      const relVelX = puck.vx - paddleVelX;
      const relVelY = puck.vy - paddleVelY;
      const relDot = relVelX * nx + relVelY * ny;

      if (relDot < 0) {
        const restitution = 1.03;
        puck.vx -= (1 + restitution) * relDot * nx;
        puck.vy -= (1 + restitution) * relDot * ny;

        puck.vx += paddleVelX * 0.35;
        puck.vy += paddleVelY * 0.35;
      }

      const puckSpeed = Math.hypot(puck.vx, puck.vy);
      if (puckSpeed > puck.maxSpeed) {
        const s = puck.maxSpeed / puckSpeed;
        puck.vx *= s;
        puck.vy *= s;
      }
    }

    function updatePuck(dt) {
      puck.x += puck.vx * dt;
      puck.y += puck.vy * dt;

      puck.vx *= 0.995;
      puck.vy *= 0.995;

      const speed = Math.hypot(puck.vx, puck.vy);
      if (speed > puck.maxSpeed) {
        const scale = puck.maxSpeed / speed;
        puck.vx *= scale;
        puck.vy *= scale;
      }

      if (puck.y - puck.r < 0) {
        puck.y = puck.r;
        puck.vy *= -1;
      }
      if (puck.y + puck.r > HEIGHT) {
        puck.y = HEIGHT - puck.r;
        puck.vy *= -1;
      }

      if (puck.x - puck.r < 0) {
        if (puck.y > GOAL_TOP && puck.y < GOAL_BOTTOM) {
          game.rightScore++;
          updateScore();
          resetPaddles();
          resetPuck(-1);
          game.goalPause = 0.8;
          return;
        } else {
          puck.x = puck.r;
          puck.vx *= -1;
        }
      }

      if (puck.x + puck.r > WIDTH) {
        if (puck.y > GOAL_TOP && puck.y < GOAL_BOTTOM) {
          game.leftScore++;
          updateScore();
          resetPaddles();
          resetPuck(1);
          game.goalPause = 0.8;
          return;
        } else {
          puck.x = WIDTH - puck.r;
          puck.vx *= -1;
        }
      }
    }

    function resolvePaddleVsPaddle(a, b) {
      const hit = circleCollision(a, b);
      if (!hit) return;

      let { dx, dy, dist, minDist } = hit;
      if (dist === 0) {
        dx = 1;
        dy = 0;
        dist = 1;
      }

      const nx = dx / dist;
      const ny = dy / dist;
      const overlap = minDist - dist;
      const push = overlap / 2;

      a.x -= nx * push;
      a.y -= ny * push;
      b.x += nx * push;
      b.y += ny * push;

      a.y = clamp(a.y, a.r, HEIGHT - a.r);
      b.y = clamp(b.y, b.r, HEIGHT - b.r);
      a.x = clamp(a.x, a.r, WIDTH / 2 - a.r - 8);
      b.x = clamp(b.x, WIDTH / 2 + b.r + 8, WIDTH - b.r);
    }

    function drawRink() {
      ctx.clearRect(0, 0, WIDTH, HEIGHT);

      ctx.fillStyle = "#dbeafe";
      ctx.fillRect(0, 0, WIDTH, HEIGHT);

      ctx.strokeStyle = "#0f172a";
      ctx.lineWidth = 4;
      ctx.strokeRect(2, 2, WIDTH - 4, HEIGHT - 4);

      ctx.beginPath();
      ctx.moveTo(WIDTH / 2, 0);
      ctx.lineTo(WIDTH / 2, HEIGHT);
      ctx.strokeStyle = "#64748b";
      ctx.lineWidth = 3;
      ctx.setLineDash([14, 10]);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.beginPath();
      ctx.arc(WIDTH / 2, HEIGHT / 2, 70, 0, Math.PI * 2);
      ctx.strokeStyle = "#94a3b8";
      ctx.lineWidth = 3;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(WIDTH * 0.22, HEIGHT / 2, 55, 0, Math.PI * 2);
      ctx.arc(WIDTH * 0.78, HEIGHT / 2, 55, 0, Math.PI * 2);
      ctx.strokeStyle = "#bfdbfe";
      ctx.stroke();

      ctx.strokeStyle = "#1e3a8a";
      ctx.lineWidth = 8;
      ctx.beginPath();
      ctx.moveTo(0, GOAL_TOP);
      ctx.lineTo(0, GOAL_BOTTOM);
      ctx.moveTo(WIDTH, GOAL_TOP);
      ctx.lineTo(WIDTH, GOAL_BOTTOM);
      ctx.stroke();
    }

    function drawPaddle(p) {
      const gradient = ctx.createRadialGradient(
        p.x - 8, p.y - 8, 6,
        p.x, p.y, p.r
      );
      gradient.addColorStop(0, "#ffffff");
      gradient.addColorStop(0.25, p.color);
      gradient.addColorStop(1, "#111827");

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = gradient;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r * 0.35, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(255,255,255,0.75)";
      ctx.fill();
    }

    function drawPuck() {
      const gradient = ctx.createRadialGradient(
        puck.x - 4, puck.y - 4, 3,
        puck.x, puck.y, puck.r
      );
      gradient.addColorStop(0, "#f8fafc");
      gradient.addColorStop(0.2, "#334155");
      gradient.addColorStop(1, "#020617");

      ctx.beginPath();
      ctx.arc(puck.x, puck.y, puck.r, 0, Math.PI * 2);
      ctx.fillStyle = gradient;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(puck.x, puck.y, puck.r + 3, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(0,0,0,0.18)";
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    function drawGoalText() {
      if (game.goalPause > 0) {
        ctx.fillStyle = "rgba(15, 23, 42, 0.75)";
        ctx.fillRect(WIDTH / 2 - 110, 20, 220, 50);

        ctx.fillStyle = "white";
        ctx.font = "bold 28px Arial";
        ctx.textAlign = "center";
        ctx.fillText("GOAL!", WIDTH / 2, 54);
      }
    }

    function loop(timestamp) {
      if (!game.lastTime) game.lastTime = timestamp;
      let dt = (timestamp - game.lastTime) / 1000;
      game.lastTime = timestamp;

      dt = Math.min(dt, 0.02);

      drawRink();

      if (game.goalPause > 0) {
        game.goalPause -= dt;
      } else {
        updatePaddle(leftPaddle, dt, "w", "s", "a", "d");
        updatePaddle(rightPaddle, dt, "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight");

        resolvePaddleVsPaddle(leftPaddle, rightPaddle);
        updatePuck(dt);
        resolvePaddleCollision(leftPaddle);
        resolvePaddleCollision(rightPaddle);
      }

      drawPaddle(leftPaddle);
      drawPaddle(rightPaddle);
      drawPuck();
      drawGoalText();

      requestAnimationFrame(loop);
    }

    window.addEventListener("keydown", (e) => {
      keys[e.key] = true;

      if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " "].includes(e.key)) {
        e.preventDefault();
      }
    });

    window.addEventListener("keyup", (e) => {
      keys[e.key] = false;
    });

    restartBtn.addEventListener("click", restartGame);

    updateScore();
    resetPaddles();
    resetPuck(Math.random() < 0.5 ? -1 : 1);
    requestAnimationFrame(loop);
  </script>
</body>
</html>

